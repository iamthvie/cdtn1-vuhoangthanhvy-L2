<mxfile host="app.diagrams.net"><diagram id="erd-l2" name="ERD L2"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="692" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ERD – luồng L2: Tiếp nhận yêu cầu bảo hành (6 bảng)" style="text;html=1;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="customer" value="&lt;b&gt;customer&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#b85450&quot;&gt;PK&lt;/font&gt; &lt;b&gt;customer_id&lt;/b&gt; &lt;font color=&quot;#777777&quot;&gt;BIGINT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; full_name &lt;font color=&quot;#777777&quot;&gt;VARCHAR(100)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; phone &lt;font color=&quot;#777777&quot;&gt;VARCHAR(15)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; created_at &lt;font color=&quot;#777777&quot;&gt;TIMESTAMPTZ&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="240" height="104" as="geometry"/></mxCell><mxCell id="device" value="&lt;b&gt;device&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#b85450&quot;&gt;PK&lt;/font&gt; &lt;b&gt;device_id&lt;/b&gt; &lt;font color=&quot;#777777&quot;&gt;BIGINT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;FK&lt;/font&gt; customer_id &lt;font color=&quot;#777777&quot;&gt;BIGINT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;UQ&lt;/font&gt; serial_no &lt;font color=&quot;#777777&quot;&gt;VARCHAR(50)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; model_name &lt;font color=&quot;#777777&quot;&gt