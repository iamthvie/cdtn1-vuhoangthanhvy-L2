#b85450&quot;&gt;&lt;/font&gt; reason &lt;font color=&quot;#777777&quot;&gt;VARCHAR(500)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; requested_by &lt;font color=&quot;#777777&quot;&gt;INTEGER&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; requested_at &lt;font color=&quot;#777777&quot;&gt;TIMESTAMPTZ&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; approval_status &lt;font color=&quot;#777777&quot;&gt;VARCHAR(10)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; decided_by &lt;font color=&quot;#777777&quot;&gt;INTEGER  (NULL)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; decided_at &lt;font color=&quot;#777777&quot;&gt;TIMESTAMPTZ  (NULL)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; decision_reason &lt;font color=&quot;#777777&quot;&gt;VARCHAR(500)  (NULL)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="260" height="194" as="geometry"/></mxCell><mxCell id="ticket_status_log" value="&lt;b&gt;ticket_status_log&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#b85450&quot;&gt;PK&lt;/font&gt; &lt;b&gt;log_id&lt;/b&gt; &lt;font color=&quot;#777777&quot;&gt;BIGINT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;FK&lt;/font&gt; ticket_id &lt;font color=&quot;#777777&quot;&gt;BIGINT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; from_status &lt;font color=&quot;#777777&quot;&gt;VARCHAR(20)  (NULL)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; to_status &lt;font color=&quot;#777777&quot;&gt;VARCHAR(20)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; changed_by &lt;font color=&quot;#777777&quot;&gt;INTEGER&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;/font&gt; changed_at &lt;font color=&quot;#777777&quot;&gt;TIMESTAMPTZ&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="260" height="140" as="geometry"/></mxCell><mxCell id="r0" value="sở hữu" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=9;" edge="1" parent="1" source="customer" target="device"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="có" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=9;" edge="1" parent="1" source="device" target="ticket"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="kèm theo" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=9;" edge="1" parent="1" source="ticket" target="ticket_accessory"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="có yêu cầu" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=9;" edge="1" parent="1" source="ticket" target="approval_request"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="ghi nhật ký" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=9;" edge="1" parent="1" source="ticket" target="ticket_status_log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;br&gt;• Mỗi khung là một bảng; dòng đầu là tên bảng. PK = khóa chính, FK = khóa ngoại, UQ = giá trị duy nhất, (NULL) = cho phép rỗng.&lt;br&gt;• Đường nối là quan hệ khóa ngoại; &quot;1&quot; ở phía bảng cha, &quot;N&quot; ở phía bảng con (một-nhiều). Nhãn trên đường nối là ý nghĩa quan hệ.&lt;br&gt;• Ngày hết hạn bảo hành không lưu thành cột: tính từ purchase_date + warranty_months (QT-05).&lt;br&gt;• service_center_id, received_by, requested_by, decided_by, changed_by là mã trung tâm/tài khoản; danh mục trung tâm và tài khoản nằm NGOÀI PHẠM VI ERD này." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="594" width="960" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>